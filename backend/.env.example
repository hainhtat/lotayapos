NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER=sqlite
JWT_SECRET=replace-with-a-long-server-secret
JWT_ISSUER=lotaya-api
JWT_AUDIENCE=lotaya-clients
WEB_ORIGIN=http://localhost:5173
DEFAULT_LOCALE=en
HUB_TIMEZONE=Asia/Yangon

# One-shot fresh-deployment provisioning inputs (do not commit real values):
SUPERADMIN_NAME=Initial Administrator
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-password
PDFINFO_PATH=pdfinfo
PDF_TO_TEXT_PATH=pdftotext

# Production PostgreSQL example:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lotaya?schema=public"
