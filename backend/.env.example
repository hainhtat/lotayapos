NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER=sqlite
JWT_SECRET=replace-with-a-long-server-secret
JWT_ISSUER=lotaya-api
JWT_AUDIENCE=lotaya-clients
WEB_ORIGIN=http://localhost:5173
# Comma-separated browser origins allowed by CORS. In development the API also allows Expo web (8081).
# WEB_ORIGIN=http://localhost:5173,http://localhost:8081
DEFAULT_LOCALE=en
HUB_TIMEZONE=Asia/Yangon

# One-shot fresh-deployment provisioning inputs (do not commit real values):
SUPERADMIN_NAME=Initial Administrator
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-password
# OS manifest PDF import uses in-process text extraction. Poppler is not required.

# Production PostgreSQL (Supabase Singapore example — do not commit real passwords):
# DATABASE_PROVIDER=postgresql
# Runtime (transaction pooler :6543):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations / pg_dump (session mode :5432):
# DIRECT_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
