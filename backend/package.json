{
  "name": "lotaya-delivery-api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:postgresql": "node scripts/test-postgresql.mjs",
    "test:integration": "jest --runInBand tests/health.test.ts tests/api-contract.test.ts tests/linked-parcels.test.ts tests/migration-upgrade.test.ts",
    "test:watch": "jest --watch",
    "db:generate": "prisma generate",
    "db:generate:sqlite": "DATABASE_PROVIDER=sqlite prisma generate --schema prisma/schema.prisma",
    "db:generate:postgresql": "DATABASE_PROVIDER=postgresql prisma generate --schema prisma/schema.postgresql.prisma",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:postgresql": "DATABASE_PROVIDER=postgresql prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "audit:os-cutover": "tsx src/scripts/audit-os-cutover.ts",
    "backfill:paid-to-os-fee": "tsx src/scripts/backfill-paid-to-os-fee-receivable.ts",
    "provision:superadmin": "tsx src/scripts/provision-superadmin.ts",
    "seed:locations": "tsx src/scripts/seed-myanmar-locations.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "latest",
    "better-sqlite3": "^13.0.3",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-validator": "latest",
    "jsonwebtoken": "latest",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "latest",
    "pino-http": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "latest",
    "@types/jest": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/supertest": "latest",
    "eslint": "latest",
    "jest": "latest",
    "prisma": "7.10.0",
    "supertest": "latest",
    "ts-jest": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
