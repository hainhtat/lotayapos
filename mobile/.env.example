EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# On a physical Android phone, localhost is the phone itself — use your computer's LAN IP instead, e.g.:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000/api/v1
# Ensure the backend CORS allows that origin and the phone can reach the host on the same Wi‑Fi.
