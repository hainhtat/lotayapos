EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# On a physical Android phone, localhost is the phone itself — use your computer's LAN IP instead, e.g.:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000/api/v1
# Ensure the backend CORS allows this origin and the phone can reach the host on the same Wi‑Fi.
# Expo web runs on http://localhost:8081 — the backend allows that in development automatically.
# Sideloaded APK updates (JSON hosted next to the APK):
# EXPO_PUBLIC_RIDER_UPDATE_URL=https://lotaya.mmds.site/app/version.json
